{
  "component": "arbol-classifier",
  "build": [
    "uv sync --locked --group dev",
    "uv run --no-sync ruff check src/arbol_classifier tests scripts bin/entry.py",
    "uv run --no-sync mypy",
    "uv run --no-sync python scripts/package_build.py"
  ],
  "entry": "bin/arbol-classifier",
  "checks": [
    {
      "name": "unit",
      "kind": "unit",
      "command": "\"$ARBOL_BUILD_DIR/runtime/python/bin/python3.14\" -I -B \"$ARBOL_BUILD_DIR/scripts/check_build.py\" unit"
    },
    {
      "name": "contract",
      "kind": "contract",
      "command": "\"$ARBOL_BUILD_DIR/runtime/python/bin/python3.14\" -I -B \"$ARBOL_BUILD_DIR/scripts/check_build.py\" contract"
    },
    {
      "name": "live",
      "kind": "live",
      "command": "\"$ARBOL_BUILD_DIR/runtime/python/bin/python3.14\" -I -B \"$ARBOL_BUILD_DIR/scripts/check_build.py\" live"
    }
  ]
}
